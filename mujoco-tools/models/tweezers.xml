<!-- Precision tweezers, 120 mm (Knipex 92 01 06 type): generated by src/build_models.py; parameters and their sources are in tools.json. -->
<mujoco model="tweezers">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.0005"/>
  <default>
    <geom condim="4" friction="0.5 0.005 0.0001"/>
  </default>
  <worldbody>
    <body name="tweezers_base" pos="0 0 0.004">
      <freejoint name="tweezers_root"/>
      <geom type="box" size="0.01 0.0007 0.004" mass="0.004" rgba="0.74 0.76 0.79 1" pos="0.01 0 0"/>
      <geom type="box" size="0.03 0.00035 0.004" mass="0.0048" rgba="0.74 0.76 0.79 1" pos="0.05 -0.00035 0" euler="0 0 0"/>
      <geom type="box" size="0.02 0.00035 0.0015" mass="0.0012" rgba="0.74 0.76 0.79 1" pos="0.1 -0.00035 0" euler="0 0 0"/>
      <site name="grip_b" pos="0.08 -0.0047 0" size="0.0025" rgba="0.2 0.5 1 0.8" group="5"/>
      <site name="tip_b" pos="0.119 0 0" size="0.0025" rgba="0.2 0.5 1 0.8" group="5"/>
      <body name="tweezers_moving">
        <joint name="hinge" type="hinge" pos="0.02 0 0" axis="0 0 1" range="0 0.18" stiffness="0.9" springref="0.12" damping="0.00090336" frictionloss="0" solreflimit="0.00125 1"/>
        <geom type="box" size="0.03 0.00035 0.004" mass="0.008" rgba="0.74 0.76 0.79 1" pos="0.05 0.00035 0" euler="0 0 0"/>
        <geom type="box" size="0.02 0.00035 0.0015" mass="0.002" rgba="0.74 0.76 0.79 1" pos="0.1 0.00035 0" euler="0 0 0"/>
        <site name="grip_a" pos="0.08 0.0047 0" size="0.0025" rgba="0.2 0.5 1 0.8" group="5"/>
        <site name="tip_a" pos="0.119 0 0" size="0.0025" rgba="0.2 0.5 1 0.8" group="5"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- The two parts meet only through the joint (and its limits), also when the base is welded down. -->
    <exclude body1="tweezers_base" body2="tweezers_moving"/>
  </contact>
</mujoco>
